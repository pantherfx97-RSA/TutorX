rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "pantherfx97@gmail.com" && request.auth.token.email_verified == true));
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'fullName', 'role', 'createdAt']) &&
             data.keys().hasOnly(['email', 'fullName', 'role', 'createdAt', 'learningProgress', 'completedTopics', 'quizScores', 'tier', 'streak', 'questionsAskedToday', 'uploadedDocuments', 'xp', 'completedMasterclasses', 'bookmarkedLessons']) &&
             data.email is string &&
             data.fullName is string && data.fullName.size() < 100 &&
             data.role in ['Tutor', 'Student'] &&
             data.tier in ['FREE', 'PRO', 'ENTERPRISE'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
